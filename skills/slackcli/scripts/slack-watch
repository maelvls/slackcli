#!/usr/bin/env bash
# slack-watch: block until someone posts after a Slack message, then print the
# new messages as JSON and exit. Unlike `slackcli watch`, it polls (no websocket),
# so it does not lose the messages posted while the connection is down.
#
# Usage: slack-watch '<permalink>' [--interval 60] [--timeout 1h] [--after <ts>]
#                    [--max-body-chars 4000] [--resolve-users]
#
# Watches both the thread of the permalinked message and the channel/DM history
# after it, so a reply in the thread and a new top-level DM message both count.
# Messages already posted after the permalinked one when the watch starts are
# returned at once. Your own messages are included.
#
# Exit codes: 0 new messages printed, 2 --timeout reached, 3 auth errors on 10
# polls in a row (run `slackcli auth import-desktop`). Network errors are
# retried forever, so it survives a closed lid or a dropped VPN.
set -uo pipefail

url="" interval=60 timeout="" after="" mbc=4000 resolve=()
while [ $# -gt 0 ]; do
  case "$1" in
    --interval) interval="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    --after) after="$2"; shift 2 ;;
    --max-body-chars) mbc="$2"; shift 2 ;;
    --resolve-users) resolve=(--resolve-users); shift ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) url="$1"; shift ;;
  esac
done
[ -n "$url" ] || { echo "usage: slack-watch '<permalink>' [--interval 60] [--timeout 1h] [--after <ts>]" >&2; exit 1; }

workspace=$(sed -nE 's#^(https://[^/]+)/archives/.*#\1#p' <<<"$url")
channel=$(sed -nE 's#.*/archives/([A-Z0-9]+)/p[0-9]+.*#\1#p' <<<"$url")
p=$(sed -nE 's#.*/archives/[A-Z0-9]+/p([0-9]+).*#\1#p' <<<"$url")
[ -n "$workspace" ] && [ -n "$channel" ] && [ -n "$p" ] || { echo "slack-watch: not a message permalink: $url" >&2; exit 1; }
msg_ts="${p:0:${#p}-6}.${p: -6}"
[ -n "$after" ] || after="$msg_ts"

deadline=""
if [ -n "$timeout" ]; then
  n="${timeout%[smhd]}"
  case "$timeout" in *s) m=1 ;; *m) m=60 ;; *h) m=3600 ;; *d) m=86400 ;; *) m=1 ;; esac
  deadline=$(( $(date +%s) + n * m ))
fi

# history prints the channel's top-level messages after $after. `message list
# --limit N` returns the newest N of them, so after a long outage in a busy
# channel it pages back with --latest until a page comes back short. The
# workspace comes from the permalink: a bare channel ID would otherwise be
# looked up in the default workspace.
history() {
  local out="" page latest=()
  while :; do
    page=$(slackcli message list "$channel" --workspace "$workspace" --oldest "$after" "${latest[@]}" \
      --limit 1000 --max-body-chars "$mbc" "${resolve[@]}" 2>/dev/null) || return 1
    out+="$page"
    [ "$(jq '.messages | length' <<<"$page")" -ge 1000 ] || break
    latest=(--latest "$(jq -r '.messages[0].ts' <<<"$page")")
  done
  printf '%s' "$out"
}

fails=0
while :; do
  thread=$(slackcli message list "$url" --max-body-chars "$mbc" "${resolve[@]}" 2>/dev/null) || thread=""
  hist=$(history) || hist=""
  if [ -z "$thread" ] && [ -z "$hist" ]; then
    err=$(slackcli message get "$url" 2>&1 >/dev/null | head -1)
    # Network errors (lid closed, VPN down) are retried forever; only
    # auth-looking errors count towards giving up.
    if grep -qiE 'auth|token|credential|sign.?in|cookie|revoked' <<<"$err"; then fails=$((fails + 1)); fi
    echo "slack-watch: slackcli failed (auth failures in a row: $fails): $err" >&2
    if [ "$fails" -ge 10 ]; then
      echo "slack-watch: giving up; run 'slackcli auth import-desktop' then rerun with --after $after" >&2
      exit 3
    fi
  else
    fails=0
    out=$(jq -s --arg after "$after" '
      (map(.messages // []) | add // [] | unique_by(.ts)
        | map(select((.ts | tonumber) > ($after | tonumber))) | sort_by(.ts | tonumber)) as $m
      | {messages: $m, referenced_users: (map(.referenced_users // {}) | add // {})}
      | if (.referenced_users | length) == 0 then del(.referenced_users) else . end
    ' <<<"$thread$hist")
    if [ "$(jq '.messages | length' <<<"$out")" -gt 0 ]; then
      echo "$out"
      exit 0
    fi
  fi
  pause="$interval"
  if [ -n "$deadline" ]; then
    left=$(( deadline - $(date +%s) ))
    if [ "$left" -le 0 ]; then
      echo "slack-watch: timed out; rerun with --after $after to continue" >&2
      exit 2
    fi
    # Wake up at the deadline at the latest, for one last poll.
    [ "$left" -lt "$pause" ] && pause="$left"
  fi
  sleep "$pause"
done
